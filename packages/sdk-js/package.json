{
  "name": "@railflag/sdk-js",
  "version": "0.2.0",
  "description": "Railflag OpenFeature provider for browsers: remote evaluation, live updates",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/railflag/sdks.git",
    "directory": "packages/sdk-js"
  },
  "homepage": "https://railflag.com/openfeature",
  "bugs": {
    "url": "https://github.com/railflag/sdks/issues"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "openfeature",
    "openfeature-provider",
    "railflag",
    "browser",
    "web"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@openfeature/core": "^1.9.0",
    "@openfeature/web-sdk": "^1.6.0"
  },
  "devDependencies": {
    "@openfeature/core": "1.9.2",
    "@openfeature/web-sdk": "1.6.2",
    "tsup": "8.5.0"
  }
}
